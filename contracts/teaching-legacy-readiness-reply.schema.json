                                "description": "Projection namespace. This does not automatically prefix predicate symbols; each predicate must carry its complete qualified symbol."
                              },
                              "entities": {
                                "type": "array",
                                "items": {
                                  "type": "string"
                                },
                                "description": "Stable entity identifiers, not display names: 1–128 ASCII characters, beginning with a letter or digit, followed by letters, digits, underscore, dot, colon or hyphen; no spaces. Preserve existing accepted identifiers. Distinct entities must not collapse onto the same identifier. Choosing an identifier does not change or resolve ambiguous entity meaning."
                              },
                              "predicates": {
                                "type": "array",
                                "items": {
                                  "type": "object",
                                  "properties": {
                                    "symbol": {
                                      "type": "string",
                                      "description": "Complete qualified predicate symbol, for example domain.measure, not a bare measure name. Use at least two dot-separated identifier segments; each starts with an ASCII letter or underscore and continues with ASCII letters, digits or underscores. Maximum 200 characters. Preserve an existing predicate's exact symbol when supplied."
                                    },
                                    "kind": {
                                      "type": "string",
                                      "enum": [
                                        "boolean",
                                        "integer",
                                        "enum"
                                      ],
                                      "description": "Source predicate kind: boolean, integer or enum. These spellings differ from the bool/int kinds in plan.types. Integer bounds define a numeric carrier, not string enum labels."
                                    },
                                    "unit": {
                                      "type": "string",
                                      "description": "Required nonempty unit, at most 100 characters, consistent with the supplied meaning and extracted facts. Use 'unitless' only for genuinely unitless predicates. Never fill an unknown physical unit or alter a numeric scale merely to satisfy the format."
                                    },
                                    "minimum": {
                                      "type": "integer",
                                      "description": "minimum and maximum are integer fields. For integer predicates they are the inclusive carrier bounds. Always keep minimum <= maximum, a span <= 1000000 and both within [-9007199254740991, 9007199254740991]; for boolean/enum use 0 and 100 when unused."
                                    },
                                    "maximum": {
                                      "type": "integer",
                                      "description": "minimum and maximum are integer fields. For integer predicates they are the inclusive carrier bounds. Always keep minimum <= maximum, a span <= 1000000 and both within [-9007199254740991, 9007199254740991]; for boolean/enum use 0 and 100 when unused."
                                    },
                                    "values": {
                                      "type": "array",
                                      "items": {
                                        "type": "string"
                                      },
                                      "description": "For boolean and integer predicates, values must be []. For enum predicates only, provide a nonempty array of unique, nonempty string labels. These are the permitted carrier labels, not observations or a list of numeric bounds converted to strings."
                                    }
                                  },
                                  "required": [
                                    "symbol",
                                    "kind",
                                    "unit",
                                    "minimum",
                                    "maximum",
                                    "values"
                                  ],

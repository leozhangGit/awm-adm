                            "type": "string",
                            "enum": [
                              "second",
                              "minute",
                              "hour",
                              "day",
                              "month",
                              "year",
                              "window",
                              "legacy"
                            ],
                            "description": "Decide whether the source names one exact clock instant or an uncertain occurrence window. For kind instant (or an exact time anchor), use precision second and effective_to null. Second is the supported coordinate resolution for that exact instant, not a claim about instrument accuracy. Do not choose hour/minute precision merely because lower clock components are omitted from a uniquely specified clock time. An approximate or rounded observation time must instead retain its supported occurrence window and precision; never invent a precise instant or window bounds. Clarify genuinely missing temporal meaning. Windows/intervals retain their supported precision. legacy is compatibility metadata, not a new observation."
                          },
                          "timezone_basis": {
                            "type": "string",
                            "description": "Captured IANA timezone name (UTC is allowed). Use the relevant explicit source/user zone, otherwise the supplied system default. UTC encoding of bounds does not change this provenance. legacy_unrecorded is reserved for retained legacy compatibility metadata."
                          }

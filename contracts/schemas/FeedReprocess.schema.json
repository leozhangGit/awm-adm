{
  "$id": "urn:awm-adm:m0:FeedReprocess",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "expected_generation": {
      "minimum": 1,
      "title": "Expected Generation",
      "type": "integer"
    },
    "idempotency_key": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Idempotency Key",
      "type": "string"
    },
    "source_sequence": {
      "minimum": 1,
      "title": "Source Sequence",
      "type": "integer"
    }
  },
  "required": [
    "idempotency_key",
    "expected_generation",
    "source_sequence"
  ],
  "title": "Reprocess",
  "type": "object"
}

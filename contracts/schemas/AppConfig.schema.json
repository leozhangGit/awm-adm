          "title": "Fallback",
          "type": "string"
        },
        "lean_executable": {
          "default": "/opt/lean/bin/lean",
          "maxLength": 4096,
          "minLength": 1,
          "title": "Lean Executable",
          "type": "string"
        },
        "required_lean_version": {
          "const": "4.19.0",
          "default": "4.19.0",
          "title": "Required Lean Version",
          "type": "string"
        }
      },
      "title": "Proof",
      "type": "object"
    },
    "Quotas": {

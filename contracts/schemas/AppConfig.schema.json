        "event_days": {
          "default": 30,
          "maximum": 3650,
          "minimum": 1,
          "title": "Event Days",
          "type": "integer"
        },
        "idempotency_days": {
          "default": 90,
          "maximum": 3650,
          "minimum": 1,
          "title": "Idempotency Days",
          "type": "integer"

        "max_output_tokens": {
          "default": 24576,
          "maximum": 10000000,
          "minimum": 1,
          "title": "Max Output Tokens",
          "type": "integer"
        },
        "max_work": {
          "default": 6000000,
          "maximum": 1000000000,
          "minimum": 1,
          "title": "Max Work",
          "type": "integer"
        },
        "no_progress_attempts": {
          "default": 2,
          "maximum": 100,
          "minimum": 1,
          "title": "No Progress Attempts",
          "type": "integer"
        },
        "private_draft_bytes": {
          "default": 2097152,
          "maximum": 16777216,
          "minimum": 1024,
          "title": "Private Draft Bytes",
          "type": "integer"
        }
      },
      "title": "EpisodeLimits",
      "type": "object"
    },
    "Learning": {
      "additionalProperties": false,
      "properties": {
        "call": {
          "$ref": "#/$defs/CallLimits"
        },
        "default_conflict_mode": {
          "default": "backward",
          "enum": [
            "backward",
            "forward"
          ],
          "title": "Default Conflict Mode",
          "type": "string"
        },
        "episode": {
          "$ref": "#/$defs/EpisodeLimits"
        },
        "publication": {
          "default": "review",
          "enum": [
            "review",
            "checked_auto"
          ],
          "title": "Publication",
          "type": "string"
        },
        "quotas": {
          "$ref": "#/$defs/Quotas"
        },
        "remote_calls_enabled": {
          "default": false,
          "title": "Remote Calls Enabled",
          "type": "boolean"
        }
      },
      "title": "Learning",
      "type": "object"
    },
    "Proof": {
      "additionalProperties": false,
      "properties": {
        "fallback": {
          "const": "forbidden",

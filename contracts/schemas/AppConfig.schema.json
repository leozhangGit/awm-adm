        "data_dir": {
          "default": ".local/data",
          "maxLength": 4096,
          "minLength": 1,
          "title": "Data Dir",
          "type": "string"
        },
        "max_body_bytes": {
          "default": 2097152,
          "maximum": 2097152,
          "minimum": 1024,
          "title": "Max Body Bytes",
          "type": "integer"
        },
        "port": {
          "default": 8080,
          "maximum": 65535,
          "minimum": 1024,
          "title": "Port",
          "type": "integer"
        }

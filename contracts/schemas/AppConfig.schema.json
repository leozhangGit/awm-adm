      "title": "Config Profile",
      "type": "string"
    },
    "learning": {
      "$ref": "#/$defs/Learning"
    },
    "proof": {
      "$ref": "#/$defs/Proof"
    },
    "request": {
      "$ref": "#/$defs/RequestLimits"
    },
    "retention": {
      "$ref": "#/$defs/Retention"
    },
    "runtime": {
      "$ref": "#/$defs/RuntimeLimits"
    },
    "server": {
      "$ref": "#/$defs/Server"
    },
    "sources": {
      "$ref": "#/$defs/Sources"
    }
  },
  "title": "AppConfig",
  "type": "object"
}

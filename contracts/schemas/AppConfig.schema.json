        "queue_items_per_adm": {
          "default": 1000,
          "maximum": 100000,
          "minimum": 1,
          "title": "Queue Items Per Adm",
          "type": "integer"
        },
        "serving_processes": {
          "default": 2,
          "maximum": 32,
          "minimum": 1,
          "title": "Serving Processes",
          "type": "integer"
        }

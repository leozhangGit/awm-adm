        "max_calls": {
          "default": 1,
          "maximum": 1,
          "minimum": 1,
          "title": "Max Calls",
          "type": "integer"
        },
        "max_duration_ms": {
          "default": 60000,
          "maximum": 600000,
          "minimum": 1,
          "title": "Max Duration Ms",
          "type": "integer"
        },
        "max_input_tokens": {
          "default": 32000,
          "maximum": 1050000,
          "minimum": 1,
          "title": "Max Input Tokens",
          "type": "integer"
        },
        "max_output_tokens": {
          "default": 8192,
          "maximum": 100000,
          "minimum": 1,
          "title": "Max Output Tokens",
          "type": "integer"
        }
      },
      "title": "CallLimits",
      "type": "object"
    },
    "EpisodeLimits": {
      "additionalProperties": false,
      "properties": {
        "max_calls": {
          "default": 3,
          "maximum": 100,
          "minimum": 1,
          "title": "Max Calls",
          "type": "integer"
        },
        "max_duration_ms": {
          "default": 360000,
          "maximum": 86400000,
          "minimum": 1,
          "title": "Max Duration Ms",
          "type": "integer"
        },
        "max_input_tokens": {
          "default": 96000,
          "maximum": 10000000,
          "minimum": 1,
          "title": "Max Input Tokens",
          "type": "integer"

          "default": 86400,
          "maximum": 2592000,
          "minimum": 60,
          "title": "Period Seconds",
          "type": "integer"
        }
      },
      "title": "Quotas",
      "type": "object"
    },
    "RequestLimits": {
      "additionalProperties": false,

        "conversation_check_processes": {
          "default": 1,
          "maximum": 4,
          "minimum": 1,
          "title": "Conversation Check Processes",
          "type": "integer"
        },
        "installation_storage_bytes": {
          "default": 5368709120,
          "maximum": 1099511627776,
          "minimum": 1048576,
          "title": "Installation Storage Bytes",
          "type": "integer"

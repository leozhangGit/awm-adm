{
  "$id": "urn:awm-adm:m0:FeedControl",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "enabled": {
      "title": "Enabled",
      "type": "boolean"
    },
    "expected_generation": {
      "minimum": 1,
      "title": "Expected Generation",
      "type": "integer"
    },
    "expected_revision": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Expected Revision",
      "type": "string"
    }
  },
  "required": [
    "expected_generation",
    "expected_revision",
    "enabled"
  ],
  "title": "FeedControl",
  "type": "object"
}
